/** 3 Angle Events inquiry backend. Bind this script to the dedicated Event Inquiries spreadsheet. */
const HEADERS=['Submitted At','Inquiry ID','Status','Client Name','Email','Phone','Organization','Event Type','Event Date','Alternate Date','Start Time','End Time','Venue / Location','City','Guest Count','Budget Range','Services Requested','Event Description','Special Requirements','Preferred Contact','Consent'];
function doPost(e){const lock=LockService.getScriptLock();try{const p=JSON.parse(e.postData.contents||'{}');const key=PropertiesService.getScriptProperties().getProperty('INQUIRY_SHARED_SECRET');if(!key||p.secret!==key)throw Error('Unauthorized');const d=p.data||{};if(!p.id||!d.name||!d.email||!d.eventDate)throw Error('Missing required fields');lock.waitLock(10000);const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Event Inquiries');if(!sheet)throw Error('Event Inquiries tab missing');const clean=v=>{let s=String(v??'').slice(0,3000);return /^[=+@\-\t\r]/.test(s)?"'"+s:s};const row=[new Date(),p.id,'New',d.name,d.email,d.phone,d.organization,d.eventType,d.eventDate,d.alternateDate,d.startTime,d.endTime,d.venue,d.city,d.guestCount,d.budget,d.services,d.description,d.requirements,d.contact,d.consent].map((v,i)=>i===0?v:clean(v));sheet.appendRow(row);return ContentService.createTextOutput(JSON.stringify({ok:true,id:p.id})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:'Unable to save inquiry'})).setMimeType(ContentService.MimeType.JSON)}finally{try{lock.releaseLock()}catch(_){}}}
